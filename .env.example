# Copy this file to .env and replace every value marked "change-me".

# Shared, pre-created Docker network. Keep this an internal network.
LLM_NETWORK=spark-llm

# llama.cpp
LLAMA_CPP_REF=v0.3.0
LLAMA_LISTEN_ADDR=127.0.0.1
LLAMA_PORT=8000
MODELS_DIR=/srv/models
MODEL_FILE=model.gguf
# Leave empty for a text-only model.
MMPROJ_FILE=
# Use the real key for authenticated upstreams. For an external upstream with
# authentication disabled, blank/omitted uses a non-secret LiteLLM placeholder.
LLAMA_API_KEY=change-me-llama-upstream-key
LLAMA_CONTEXT_SIZE=8192
LLAMA_GPU_LAYERS=999
LLAMA_FLASH_ATTN=on

# LiteLLM (the client-facing OpenAI-compatible API)
LITELLM_LISTEN_ADDR=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-me-litellm-client-key
# OpenAI-compatible upstream URL reachable from inside LiteLLM; include /v1.
# For Unsloth, use e.g. http://unsloth-host:8888/v1 and its key as LLAMA_API_KEY.
LLAMA_API_BASE=http://llama-server:8000/v1
# Name exposed by LiteLLM and selected in NextChat (or wildcard route pattern).
LITELLM_MODEL=local-llama
# Model name sent by LiteLLM to llama.cpp. llama.cpp normally accepts any name.
LLAMA_CPP_MODEL_NAME=local-llama
# For Unsloth wildcard routing, set LITELLM_MODEL=openai/* and
# LLAMA_CPP_MODEL_NAME=*. Clients request openai/<upstream-model-id>.
# Optional Ollama URL reachable from inside LiteLLM, e.g. http://ollama-host:11434.
# Leave blank or omit to disable Ollama routes and discovery.
OLLAMA_API_BASE=

# Postgres for the LiteLLM playground (starts with LiteLLM).
# Generate a URL-safe password with: openssl rand -hex 32
LITELLM_POSTGRES_PASSWORD=change-me-generated-hex-password
# DATABASE_URL is constructed automatically; an existing override is honored.
LITELLM_POSTGRES_TMPFS_SIZE=1g
LITELLM_UI_USERNAME=admin
# Optional separate UI password; defaults to LITELLM_MASTER_KEY if omitted.
# LITELLM_UI_PASSWORD=replace-with-a-separate-ui-password

# NextChat
NEXTCHAT_LISTEN_ADDR=127.0.0.1
NEXTCHAT_PORT=3000
# Optional: leave blank or omit to disable the UI access code.
NEXTCHAT_ACCESS_CODE=change-me-nextchat-access-code
# Optional extra NextChat models; litellm/ollama-models.py prints a shell export.
OLLAMA_MODELS=
